// reduce.okl — BLAS-1 reduction operations
// dot:   s = x^T y   (each block writes one partial sum)
// nrm2:  s = ||x||_2 (sqrt taken on host)
// asum:  s = ||x||_1
// sumReduce: generic partial reduction for multi-level pipeline
//
// This is the ONLY file in the project that uses @shared memory.
// The tree-reduction pattern follows the OCCA official reductionWithSharedMemory
// reference (third_party/occa/examples/cpp/04_reduction/reduction.okl).
//
// Constraint: all @inner loops iterate exactly TILE_SIZE times (the
// "equal @inner iteration count" rule).

// x^T y — per-block partial sum
@kernel void dot(const int n, const Real *x, const Real *y, Real *partial) {
  for (int group = 0; group < ((n + TILE_SIZE - 1) / TILE_SIZE); ++group; @outer) {
    @shared Real s_sum[TILE_SIZE];

    // ① Load — out-of-bounds elements contribute 0.0
    for (int item = 0; item < TILE_SIZE; ++item; @inner) {
      const int i = group * TILE_SIZE + item;
      s_sum[item] = (i < n) ? x[i] * y[i] : 0.0;
    }

    // ② Tree reduction (log2(TILE_SIZE) rounds, full-width @inner + guard)
    for (int alive = TILE_SIZE / 2; alive > 0; alive /= 2) {
      for (int item = 0; item < TILE_SIZE; ++item; @inner) {
        if (item < alive) {
          s_sum[item] += s_sum[item + alive];
        }
      }
    }

    // ③ Write-back — thread 0 only
    for (int item = 0; item < TILE_SIZE; ++item; @inner) {
      if (item == 0) {
        partial[group] = s_sum[0];
      }
    }
  }
}

// ||x||_2 — per-block partial sum of squares (sqrt on host)
@kernel void nrm2(const int n, const Real *x, Real *partial) {
  for (int group = 0; group < ((n + TILE_SIZE - 1) / TILE_SIZE); ++group; @outer) {
    @shared Real s_sum[TILE_SIZE];

    for (int item = 0; item < TILE_SIZE; ++item; @inner) {
      const int i = group * TILE_SIZE + item;
      s_sum[item] = (i < n) ? x[i] * x[i] : 0.0;
    }

    for (int alive = TILE_SIZE / 2; alive > 0; alive /= 2) {
      for (int item = 0; item < TILE_SIZE; ++item; @inner) {
        if (item < alive) {
          s_sum[item] += s_sum[item + alive];
        }
      }
    }

    for (int item = 0; item < TILE_SIZE; ++item; @inner) {
      if (item == 0) {
        partial[group] = s_sum[0];
      }
    }
  }
}

// ||x||_1 — per-block partial sum of absolute values
@kernel void asum(const int n, const Real *x, Real *partial) {
  for (int group = 0; group < ((n + TILE_SIZE - 1) / TILE_SIZE); ++group; @outer) {
    @shared Real s_sum[TILE_SIZE];

    for (int item = 0; item < TILE_SIZE; ++item; @inner) {
      const int i = group * TILE_SIZE + item;
      s_sum[item] = (i < n) ? (x[i] >= 0 ? x[i] : -x[i]) : 0.0;
    }

    for (int alive = TILE_SIZE / 2; alive > 0; alive /= 2) {
      for (int item = 0; item < TILE_SIZE; ++item; @inner) {
        if (item < alive) {
          s_sum[item] += s_sum[item + alive];
        }
      }
    }

    for (int item = 0; item < TILE_SIZE; ++item; @inner) {
      if (item == 0) {
        partial[group] = s_sum[0];
      }
    }
  }
}

// Generic sum-reduction — used by the multi-level reduction pipeline.
// Reduces `count` elements to ceil(count / TILE_SIZE) partials.
@kernel void sumReduce(const int count, const Real *v, Real *partial) {
  for (int group = 0; group < ((count + TILE_SIZE - 1) / TILE_SIZE); ++group; @outer) {
    @shared Real s_sum[TILE_SIZE];

    for (int item = 0; item < TILE_SIZE; ++item; @inner) {
      const int i = group * TILE_SIZE + item;
      s_sum[item] = (i < count) ? v[i] : 0.0;
    }

    for (int alive = TILE_SIZE / 2; alive > 0; alive /= 2) {
      for (int item = 0; item < TILE_SIZE; ++item; @inner) {
        if (item < alive) {
          s_sum[item] += s_sum[item + alive];
        }
      }
    }

    for (int item = 0; item < TILE_SIZE; ++item; @inner) {
      if (item == 0) {
        partial[group] = s_sum[0];
      }
    }
  }
}
