// surface_integral.okl — Surface integral of the numerical flux.
//
// "Compute" half of the "compute then gather" strategy (see
// docs/tech_docs/governed_equations_and_DG_field.md, Section (三)); the
// gather half is fused into assemble_rhs.okl:
//
//   1. computeFaceFlux:  per face, accumulate the weighted numerical flux
//      onto the face's modal slots. Output faceFlux[F][var][side][mode],
//      side 0 = left element, side 1 = right element:
//
//        faceFlux[F][var][side][mode]
//          = sum_i faceW[i] * |J_f| * F_hat[var](t_i) * Vface[side][f][i][mode]
//
//      where f is the face number in the element on that side itself
//      (side 0 -> fL, side 1 -> fR); Vface[0] is built from
//      faceRefMapLeft and Vface[1] from faceRefMapRight.
//
//   2. (fused) assembleRHS in assemble_rhs.okl gathers, per element and
//      with the appropriate sign (left element +, right element -), the
//      face flux into the weak-form surface integral
//
//        R_surf[e][var][mode] = sum_faces sign * faceFlux[F][var][side][mode]
//
//      and immediately contracts it against the inverse mass matrix,
//      res = M^-1 ( R_vol - R_surf ), without a separate R_surf scratch
//      round-trip.
//
// The numerical flux is obtained from the Riemann solver family selected
// at JIT compile time by the FLUX_TYPE define. Only LLF is implemented in
// this stage; the remaining branches are reserved placeholders that the
// preprocessor removes entirely, so the compiled binary contains no
// runtime flux-type branch.

#include "llf.okl"

// --- computeFaceFlux ---------------------------------------------------------
// One thread per face. For each face quadrature point the left/right
// conserved states are interpolated from the modal coefficients via the
// face Vandermonde matrices, the numerical flux is computed (rotate ->
// flux -> rotate back), and the weighted flux is accumulated.

@kernel void computeFaceFlux(const int N_face, const int N_vars,
                             const int N_modes, const int N_q, const Real *u,
                             const Real *Vface, const Real *faceW,
                             const int *faceKL, const int *faceFL,
                             const int *faceKR, const int *faceFR,
                             const Real *faceN, const Real *faceJ,
                             const Real *freeState, const int *faceBcType,
                             const int *bfMap, const Real *bcGhost,
                             const Real *u0, const int riemannTarget,
                             const Real gamma, Real *faceFlux) {
    for (int F = 0; F < N_face; ++F; @tile(TILE_SIZE, @outer, @inner)) {
        const int KL = faceKL[F];
        const int fL = faceFL[F];
        const int KR = faceKR[F];
        const int fR = faceFR[F];

        // Collapsed (triangle) face: nothing to integrate (zero the slots and
        // skip the flux work).
        if (fL >= 0) {
            // Unit normal from the un-normalised face normal and face Jacobian:
            //   |J_f| = |e| / 2 and |n_hat| = |e|, hence n_unit = n_hat / (2 |J_f|).
            const Real nUx = faceN[F * 2 + 0] / ((Real)2 * faceJ[F]);
            const Real nUy = faceN[F * 2 + 1] / ((Real)2 * faceJ[F]);

            // Pass 1: physical flux at every face quadrature point, stored
            // locally, row-major [quad point][var] (N_q <= NQ_MAX).
            Real fp[NQ_MAX][N_VARS];
            for (int i = 0; i < N_q; ++i) {
                // Interpolate left state at face point t_i.
                Real qL[N_VARS];
                for (int var = 0; var < N_VARS; ++var) {
                    Real acc = 0.0;
                    const int vBase =
                        (0 * 4 + fL) * (N_q * N_modes) + i * N_modes;
                    const int uBase = KL * N_vars * N_modes + var * N_modes;
                    for (int m = 0; m < N_modes; ++m) {
                        acc += Vface[vBase + m] * u[uBase + m];
                    }
                    qL[var] = acc;
                }

                // Interpolate right state; boundary faces take an exterior
                // state from the per-face boundary-condition type
                // (faceBcType, resolved host-side from the global [bc] type,
                // per-side overrides and the split_x classification):
                // farfield uses the constant free-stream state, the free
                // (zero-gradient) boundary copies the interior trace — the
                // numerical flux of (q, q) is the pure physical flux,
                // exactly neutral while the wall-adjacent flow is constant —
                // the slip wall mirrors the interior trace with the normal
                // momentum negated (zero wall-normal mass flux), the expr
                // (Dirichlet) boundary reads a conserved ghost state
                // evaluated host-side from the [bc] expressions at
                // (x, y, t), and the characteristic (Riemann /
                // pressure far-field) boundary builds the state from the
                // normal acoustic invariants.
                Real qR[N_VARS];
                // Per-face resolved boundary type (BcType as int); consulted
                // only on boundary faces (KR < 0), a dummy on the rest.
                const int bct = faceBcType[F];
                if (KR >= 0) {
                    for (int var = 0; var < N_VARS; ++var) {
                        Real acc = 0.0;
                        // Right state interpolated with Vface[side=1][fR]:
                        // faceRefMapRight is keyed by the *right* element's own
                        // local face number (see the NOTE below).
                        const int vBase =
                            (1 * 4 + fR) * (N_q * N_modes) + i * N_modes;
                        const int uBase = KR * N_vars * N_modes + var * N_modes;
                        for (int m = 0; m < N_modes; ++m) {
                            acc += Vface[vBase + m] * u[uBase + m];
                        }
                        qR[var] = acc;
                    }
                } else if (bct == 2) {
                    // BcType::Free.
                    for (int var = 0; var < N_VARS; ++var) {
                        qR[var] = qL[var];
                    }
                } else if (bct == 6) {
                    // BcType::FreeAvg — the interior element's MEAN as the
                    // exterior state: the constant mode u^(0) with
                    // phi_0 = 1/2 gives mean = u^(0)/2 (exact on affine
                    // elements). The finite-volume edge-pad analogue:
                    // unlike the pointwise free trace, the constant mode
                    // carries no high-order oscillation, so a shock
                    // crossing the wall cell feeds only its mean through
                    // the boundary flux.
                    const int uBaseM = KL * N_vars * N_modes;
                    for (int var = 0; var < N_VARS; ++var) {
                        qR[var] = 0.5 * u[uBaseM + var * N_modes];
                    }
                } else if (bct == 4) {
                    // BcType::Slip — reflection (slip) wall: mirror the
                    // interior trace, negating the normal momentum
                    // $$ m_{\mathrm{ghost}} = m - 2 (m \cdot \hat n)\,
                    //    \hat n, \qquad \rho_{\mathrm{ghost}} = \rho,
                    //    \; E_{\mathrm{ghost}} = E. $$
                    // Any consistent numerical flux then produces
                    // exactly zero wall-normal mass flux (the symmetric
                    // Riemann solution has $v_n = 0$ at the wall).
                    const Real mn = qL[1] * nUx + qL[2] * nUy;
                    qR[0] = qL[0];
                    qR[1] = qL[1] - 2.0 * mn * nUx;
                    qR[2] = qL[2] - 2.0 * mn * nUy;
                    qR[3] = qL[3];
                } else if (bct == 5) {
                    // BcType::Expr — Dirichlet state from the [bc]
                    // expressions, evaluated host-side at (x, y, t) on
                    // this face point and uploaded once per time step.
                    const int bf = bfMap[F];
                    for (int var = 0; var < N_VARS; ++var) {
                        qR[var] = bcGhost[(bf * N_q + i) * N_VARS + var];
                    }
                } else if (bct == 3) {
                // BcType::Riemann — characteristic (Riemann-invariant /
                // pressure far-field) non-reflecting boundary state.
                // The outgoing acoustic invariant carries the interior,
                // the incoming one the reference state (the pressure
                // anchoring mechanism):
                //
                // $$ R^+_b = V_{n,i} + \frac{2 c_i}{\gamma - 1} \;\;(\text{outgoing, interior}), \qquad R^-_b = V_{n,\infty} - \frac{2 c_\infty}{\gamma - 1} \;\;(\text{incoming, reference}). $$
                //
                // Entropy and the tangential velocity follow the flow
                // direction (interior on the outflow side, reference on
                // the inflow side), so a subsonic outflow anchors only
                // the pressure: outgoing waves leave without
                // reflection, unlike the zero-gradient branch whose
                // acoustic Neumann behaviour reflects them back.
                Real qT[N_VARS];
                if (riemannTarget == 2) {
                    // "expr" target — analytic wall data: the [bc]
                    // rho/u/v/p expressions evaluated host-side at
                    // (x, y, t) on this face point and refreshed once per
                    // time step (the same buffer the Dirichlet branch
                    // reads). The reference then follows moving waves
                    // instead of a frozen snapshot.
                    const int bf = bfMap[F];
                    for (int var = 0; var < N_VARS; ++var) {
                        qT[var] = bcGhost[(bf * N_q + i) * N_VARS + var];
                    }
                } else if (riemannTarget == 1) {
                    // "ic" target: trace of the initial field at this
                    // face point (same side-0 face-Vandermonde rows
                    // the left-state interpolation uses).
                    const int vBase0 =
                        (0 * 4 + fL) * (N_q * N_modes) + i * N_modes;
                    const int u0Base = KL * N_vars * N_modes;
                    for (int var = 0; var < N_VARS; ++var) {
                        Real acc = 0.0;
                        for (int m = 0; m < N_modes; ++m) {
                            acc += Vface[vBase0 + m] *
                                   u0[u0Base + var * N_modes + m];
                        }
                        qT[var] = acc;
                    }
                } else {
                    // "flow" target: the constant free-stream state.
                    for (int var = 0; var < N_VARS; ++var) {
                        qT[var] = freeState[var];
                    }
                }
                const Real gm1  = gamma - 1.0;
                const Real rhoI = qL[0];
                const Real pI   = gm1 * (qL[3] - 0.5 * (qL[1] * qL[1] +
                                                       qL[2] * qL[2]) /
                                                    rhoI);
                const Real rhoT = qT[0];
                const Real pT   = gm1 * (qT[3] - 0.5 * (qT[1] * qT[1] +
                                                       qT[2] * qT[2]) /
                                                    rhoT);
                if (rhoI <= 0.0 || pI <= 0.0 || rhoT <= 0.0 ||
                    pT <= 0.0) {
                    // Degenerate primitives: fall back to the free
                    // branch rather than feeding sqrt a negative.
                    for (int var = 0; var < N_VARS; ++var) {
                        qR[var] = qL[var];
                    }
                } else {
                    const Real cI  = sqrt(gamma * pI / rhoI);
                    const Real cT  = sqrt(gamma * pT / rhoT);
                    const Real vnI = (qL[1] * nUx + qL[2] * nUy) / rhoI;
                    const Real vtI = (-qL[1] * nUy + qL[2] * nUx) / rhoI;
                    const Real vnT = (qT[1] * nUx + qT[2] * nUy) / rhoT;
                    const Real vtT = (-qT[1] * nUy + qT[2] * nUx) / rhoT;
                    if (vnI >= cI || vnI <= -cI) {
                        // Supersonic guard: a pure outflow reflects
                        // nothing (interior state); a pure inflow is
                        // imposed entirely by the reference state.
                        const bool out = (vnI > 0.0);
                        for (int var = 0; var < N_VARS; ++var) {
                            qR[var] = out ? qL[var] : qT[var];
                        }
                    } else {
                        // Invariant mixing (subsonic).
                        const Real rp  = vnI + 2.0 * cI / gm1;
                        const Real rm  = vnT - 2.0 * cT / gm1;
                        const Real vnB = 0.5 * (rp + rm);
                        const Real cB  = 0.25 * gm1 * (rp - rm);
                        const bool out = (vnI > 0.0);
                        const Real rhoS = out ? rhoI : rhoT;
                        const Real cS   = out ? cI : cT;
                        const Real vtB  = out ? vtI : vtT;
                        if (cB <= 0.0) {
                            for (int var = 0; var < N_VARS; ++var) {
                                qR[var] = qL[var];
                            }
                        } else {
                            // Isentropic density from the mixed sound
                            // speed, then the boundary conserved state.
                            const Real rhoB =
                                rhoS * pow(cB / cS, 2.0 / gm1);
                            const Real pB = rhoB * cB * cB / gamma;
                            const Real uB = vnB * nUx - vtB * nUy;
                            const Real vB = vnB * nUy + vtB * nUx;
                            qR[0] = rhoB;
                            qR[1] = rhoB * uB;
                            qR[2] = rhoB * vB;
                            qR[3] = pB / gm1 +
                                    0.5 * rhoB * (uB * uB + vB * vB);
                        }
                    }
                }
            } else {
                    // BcType::Farfield (0).
                    for (int var = 0; var < N_VARS; ++var) {
                        qR[var] = freeState[var];
                    }
                }

                // Numerical flux in physical space (rotate -> 1-D flux -> rotate
                // back). The flux family is selected at compile time via FLUX_TYPE.
                Real fluxPhys[N_VARS];
                Real qLr[N_VARS], qRr[N_VARS], fluxLoc[N_VARS];
                rotate_state(qL, nUx, nUy, qLr);
                rotate_state(qR, nUx, nUy, qRr);

#if FLUX_TYPE == FLUX_LLF
                llf_flux(qLr, qRr, gamma, fluxLoc);
#elif FLUX_TYPE == FLUX_ROE
                // Reserved: roe_flux(qLr, qRr, gamma, fluxLoc);
                llf_flux(qLr, qRr, gamma, fluxLoc);
#elif FLUX_TYPE == FLUX_ROEE
                // Reserved: roe_flux with entropy fix.
                llf_flux(qLr, qRr, gamma, fluxLoc);
#elif FLUX_TYPE == FLUX_STEGERWARMING
                // Reserved: steger_warming_flux.
                llf_flux(qLr, qRr, gamma, fluxLoc);
#elif FLUX_TYPE == FLUX_VANLEER
                // Reserved: van_leer_flux.
                llf_flux(qLr, qRr, gamma, fluxLoc);
#else
                llf_flux(qLr, qRr, gamma, fluxLoc);
#endif

                rotate_flux_back(fluxLoc, nUx, nUy, fluxPhys);

                for (int var = 0; var < N_VARS; ++var) {
                    fp[i][var] = fluxPhys[var];
                }
            }

            // Pass 2: single write-out per (var, l). Each slot is accumulated in
            // registers across the quadrature points instead of suffering a
            // read-modify-write per point (the 2*N_vars*N_modes accumulators
            // exceed the CPU AVX register file and depress GPU occupancy when
            // spilled to the faceFlux array). The per-point product and the
            // summation order match the original += form exactly, so the stored
            // values are bit-for-bit identical.
            for (int var = 0; var < N_vars; ++var) {
                for (int l = 0; l < N_modes; ++l) {
                    // NOTE: the right side uses the *right* element's own local face
                    // index fR for the Vface lookup. faceRefMapRight(fR) is the map
                    // of that face in the right element with the traversal reversed
                    // (clockwise w.r.t. its own counter-clockwise convention). Keying
                    // by fR instead of fL stays correct on triangle meshes, where
                    // the quad-only pairing f_R = (f_L + 2) % 4 does not hold (e.g.
                    // split-diagonal faces have (fL, fR) = (0, 1)).
                    const int vBaseL = (0 * 4 + fL) * (N_q * N_modes) + l;
                    const int vBaseR = (1 * 4 + fR) * (N_q * N_modes) + l;
                    Real accL        = 0.0;
                    Real accR        = 0.0;
                    for (int i = 0; i < N_q; ++i) {
                        const Real wJ = faceW[i] * faceJ[F];
                        const Real fv = fp[i][var];
                        accL += wJ * fv * Vface[vBaseL + i * N_modes];
                        accR += wJ * fv * Vface[vBaseR + i * N_modes];
                    }
                    faceFlux[((F * N_vars + var) * 2 + 0) * N_modes + l] = accL;
                    faceFlux[((F * N_vars + var) * 2 + 1) * N_modes + l] =
                        (KR >= 0) ? accR : 0.0;
                }
            }
        } else {
            // Degenerate face: still define the allocated slots.
            for (int var = 0; var < N_vars; ++var) {
                for (int side = 0; side < 2; ++side) {
                    for (int l = 0; l < N_modes; ++l) {
                        faceFlux[((F * N_vars + var) * 2 + side) * N_modes +
                                 l] = 0.0;
                    }
                }
            }
        }
    }
}
