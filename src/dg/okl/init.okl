// init.okl — Initial condition to modal coefficients (L2 projection).
//
// For a constant free-stream state q0 = freeState, projects onto the modal
// coefficients of every element:
//
//   b[var][m]    = sum_q lambdaWJ[q] * V2D[q][m] * freeState[var]
//   u[var][m']   = sum_m Minv[e][m'][m] * b[var][m]
//
// i.e. $\hat u = M^{-1} V^T \Lambda_{wJ} q_0$ evaluated at the quadrature
// points (which all hold the same free-stream value). This kernel is
// specific to constant initial conditions; general initial conditions are
// projected on the host via DgField::setInitialConditionNodal.
//
// See docs/tech_docs/governed_equations_and_DG_field.md, Section (一).

@kernel void initModeCoeffs(const int N_elem, const int N_vars,
                            const int N_modes, const int Nq2,
                            const Real *freeState, const Real *lambdaWJ,
                            const Real *V2D, const Real *Minv, Real *u) {
    for (int elem = 0; elem < N_elem; ++elem;
         @tile(TILE_SIZE, @outer, @inner)) {
        const int eOff  = elem * Nq2;
        const int uOff  = elem * N_vars * N_modes;
        const int mBase = elem * N_modes * N_modes;

        for (int var = 0; var < N_vars; ++var) {
            // b[m] = sum_q lambdaWJ[q] * V2D[q][m] * freeState[var]
            Real b[NMODES_MAX];
            for (int m = 0; m < N_modes; ++m) {
                Real acc = 0.0;
                for (int q = 0; q < Nq2; ++q) {
                    acc += lambdaWJ[eOff + q] * V2D[q * N_modes + m];
                }
                b[m] = acc * freeState[var];
            }

            // u[var][m'] = sum_m Minv[e][m'][m] * b[m]
            for (int mp = 0; mp < N_modes; ++mp) {
                Real acc = 0.0;
                for (int m = 0; m < N_modes; ++m) {
                    acc += Minv[mBase + mp * N_modes + m] * b[m];
                }
                u[uOff + var * N_modes + mp] = acc;
            }
        }
    }
}
